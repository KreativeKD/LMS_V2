RewriteEngine On

# If request is not a file
RewriteCond %{REQUEST_FILENAME} !-f
# If request is not a directory
RewriteCond %{REQUEST_FILENAME} !-d

# Redirect everything to index.html
RewriteRule ^ index.html [L]

# Never cache index.html — it references hashed JS/CSS bundles
<Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</Files>

# Cache hashed assets forever (they change filename when content changes)
<FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
